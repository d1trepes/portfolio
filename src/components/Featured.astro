---
// Блок 2 «Избранные проекты»: закреплённый 3D-слайдер.
// Скролл листает проекты, карточка в центре, соседние по бокам, фон перекрашивается под проект.
import '../styles/featured.css';
import { getCollection } from 'astro:content';
import { panelHTML } from '../scripts/panel';

const items = (await getCollection('projects', (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
  .map((p) => ({
    id: p.id,
    url: `/projects/${p.id}/`,
    title: p.data.title,
    tag: p.data.tag,
    bg: p.data.bg,
    h: p.data.heading ?? [p.data.title, ''],
    summary: p.data.summary,
    html: panelHTML({ type: 'p', id: p.id, title: p.data.title, tag: p.data.tag, c: p.data.palette, map: p.data.map }),
  }));
const n = items.length;
// цвет текста под фон проекта: светлый на тёмном, тёмный на светлом
const light = (h: string) => { const c = h.replace('#', ''); const [r, g, b] = [0, 2, 4].map((i) => parseInt(c.slice(i, i + 2), 16)); return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 < 0.5; };
const ink = (h: string) => (light(h) ? '#F3F3F1' : '#111111');
const pad = (i: number) => String(i).padStart(2, '0');
---
<div class="tint" id="tint" aria-hidden="true">{items.map((it) => <i style={`background:${it.bg}`}></i>)}</div>

<section class="featured" id="featured" style={`--n:${n}`} aria-label="Избранные проекты">
  <div class="fs" id="fs" data-pre data-tone={light(items[0].bg) ? 'light' : 'dark'}>
    <div class="fs-top gutter">
      <p class="fs-label">Избранные проекты</p>
      <p class="fs-count" aria-live="polite"><span class="fs-num" id="fsNum">01</span><span class="fs-of">/ {pad(n)}</span></p>
    </div>

    <div class="fs-t1 gutter" aria-hidden="true">
      {items.map((it, i) => <span class="ft" data-i={i} data-s={i === 0 ? 'cur' : 'next'} style={`--pi:${ink(it.bg)}`}><span>{it.h[0]}</span></span>)}
    </div>

    <div class="fs-zone" id="fsZone"></div>

    <div class="fs-t2 gutter" aria-hidden="true">
      {items.map((it, i) => <span class="ft" data-i={i} data-s={i === 0 ? 'cur' : 'next'} style={`--pi:${ink(it.bg)}`}><span>{it.h[1]}<svg class="ful" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9 C 48 3, 92 12, 140 7 S 236 2, 297 8" pathLength="1" /></svg></span></span>)}
    </div>

    <div class="fs-cards" id="fsCards">
      {items.map((it, i) => (
        <a class="card" href={it.url} data-id={it.id} data-i={i} data-bg={it.bg} data-tone={light(it.bg) ? 'light' : 'dark'} aria-label={`Открыть кейс: ${it.title}`}>
          <div class="card-rig"><div class="card-flat" set:html={it.html} /></div>
        </a>
      ))}
    </div>

    <div class="fs-bottom gutter">
      <div class="fs-info">
        {items.map((it, i) => (
          <div class="fi" data-i={i} data-s={i === 0 ? 'cur' : 'next'} style={`--pi:${ink(it.bg)}`}>
            <small>{it.tag}</small>
            <p>{it.summary}</p>
          </div>
        ))}
      </div>
      <div class="fs-cta"><a class="btn" id="fsOpen" href={items[0].url}>Открыть кейс</a></div>
    </div>

    <nav class="fs-dots" id="fsDots" aria-label="Проекты">
      {items.map((it, i) => <button type="button" data-i={i} aria-label={`${i + 1}. ${it.title}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>)}
    </nav>

    <div class="fs-hint" id="fsHint" aria-hidden="true"><span>Листайте</span><b><i id="fsBar"></i></b></div>
  </div>
</section>
