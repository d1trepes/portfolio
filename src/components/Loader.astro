---
// Загрузочный экран (по мотивам TRIONN): фон чуть темнее сайта, в центре четыре чёрных уголка,
// внизу по центру мелко — проценты 0–100% и тонкая полоска.
// Уголки расходятся по мере загрузки → между ними открывается квадрат, в нём виден сайт → квадрат раскрывается на весь экран.
// Стили и скрипт встроены прямо в страницу (is:inline) — экран виден с первой миллисекунды.
// Анимируется только transform (сдвиг четырёх «шторок» и крестиков) — нагрузка минимальная.
---
<div class="ld" id="ld" aria-hidden="true">
  <i class="ldp ldp--t"></i><i class="ldp ldp--b"></i><i class="ldp ldp--l"></i><i class="ldp ldp--r"></i>
  <i class="ldx ldx--tl"></i><i class="ldx ldx--tr"></i><i class="ldx ldx--bl"></i><i class="ldx ldx--br"></i>
  <div class="ld-ind"><span class="ld-name">Иван Засадыч</span><b><i id="ldBar"></i></b><span class="ld-n" id="ldN">0%</span></div>
</div>

<style is:inline>
  html.is-loading,html.is-loading body{overflow:hidden}
  .ld{--w:0px;--h:0px;--c:0px;position:fixed;z-index:1000;inset:0;pointer-events:none;color:#111;font-family:"Onest",system-ui,sans-serif}
  html.is-loading .ld{pointer-events:auto}
  /* четыре «шторки» вокруг окна: каждая на весь экран, сдвинута так, что между ними остаётся дырка w×h */
  .ldp{position:absolute;inset:0;background:#E2E2DE;will-change:transform;transition:transform 1s cubic-bezier(.76,0,.24,1)}
  .ldp--t{transform:translate3d(0,calc(-50% - var(--h) / 2),0)}
  .ldp--b{transform:translate3d(0,calc(50% + var(--h) / 2),0)}
  .ldp--l{transform:translate3d(calc(-50% - var(--w) / 2),0,0)}
  .ldp--r{transform:translate3d(calc(50% + var(--w) / 2),0,0)}
  /* чёрные уголки по углам будущего квадрата (вершина уголка — в углу квадрата, отступ 10px) */
  .ldx{position:absolute;left:50%;top:50%;width:18px;height:18px;border:0 solid #111;will-change:transform}
  .ldx--tl{border-top-width:2px;border-left-width:2px;transform:translate3d(calc(var(--c) / -2 - 10px),calc(var(--c) / -2 - 10px),0)}
  .ldx--tr{border-top-width:2px;border-right-width:2px;transform:translate3d(calc(var(--c) / 2 + 10px - 18px),calc(var(--c) / -2 - 10px),0)}
  .ldx--bl{border-bottom-width:2px;border-left-width:2px;transform:translate3d(calc(var(--c) / -2 - 10px),calc(var(--c) / 2 + 10px - 18px),0)}
  .ldx--br{border-bottom-width:2px;border-right-width:2px;transform:translate3d(calc(var(--c) / 2 + 10px - 18px),calc(var(--c) / 2 + 10px - 18px),0)}
  .ld.go .ldx{transition:transform 1s cubic-bezier(.76,0,.24,1),opacity .5s}
  /* внизу по центру: имя · полоска · проценты, мелко */
  .ld-ind{position:absolute;left:50%;bottom:calc(32px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:flex;align-items:center;gap:14px;
    font-size:12px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;transition:opacity .4s}
  .ld-ind b{position:relative;display:block;width:min(180px,28vw);height:1px;background:rgba(17,17,17,.15);overflow:hidden}
  .ld-ind b i{position:absolute;inset:0;background:#111;transform-origin:0 50%;transform:scaleX(0);will-change:transform}
  .ld-n{min-width:4ch;text-align:right;font-variant-numeric:tabular-nums}
  .ld-name{color:#6B6B67}
  .ld.go .ld-ind{opacity:0}
  .ld.full .ldx{opacity:0}
  @media (prefers-reduced-motion:reduce){.ld{transition:opacity .4s}.ld.full{opacity:0}.ldp,.ld.go .ldx{transition:none}}
</style>

<script is:inline>
  (function () {
    var html = document.documentElement, ld = document.getElementById('ld'), num = document.getElementById('ldN'), bar = document.getElementById('ldBar');
    html.classList.add('is-loading');
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    scrollTo(0, 0);
    var t0 = performance.now(), loaded = false, prepared = false, shown = 0, done = false, MIN = 1400, MAX = 6000;
    var S = function () { return Math.round(Math.min(innerWidth, innerHeight) * 0.26); }; // сторона квадрата
    // квадрат открываем, только когда страница реально готова: всё загружено, шрифты на месте,
    // фото головы раскодировано и первый экран расставлен скриптом — иначе в окне мелькает «не то»
    addEventListener('load', function () {
      loaded = true;
      var img = document.querySelector('#photo img');
      Promise.all([
        document.fonts ? document.fonts.ready : 0,
        img && img.decode ? img.decode().catch(function () {}) : 0,
      ]).then(function () {
        (function wait() {
          if (window.__heroReady) requestAnimationFrame(function () { requestAnimationFrame(function () { prepared = true; }); });
          else setTimeout(wait, 30);
        })();
      });
    });
    function tick(now) {
      var el = now - t0, ready = ((loaded && prepared) || el > MAX) && el > MIN;
      // пока грузится — ползём до 88%, загрузилось — добегаем до 100%
      var target = ready ? 100 : Math.min(88, 88 * (1 - Math.exp(-el / 900)));
      shown += (target - shown) * (ready ? 0.12 : 0.08);
      if (ready && shown > 99.4) shown = 100;
      var v = Math.round(shown) + '%';
      if (num.textContent !== v) num.textContent = v;
      bar.style.transform = 'scaleX(' + (shown / 100).toFixed(3) + ')';
      ld.style.setProperty('--c', (S() * shown / 100).toFixed(1) + 'px'); // уголки расходятся вместе с загрузкой
      if (shown >= 100 && !done) { done = true; finish(); return; }
      requestAnimationFrame(tick);
    }
    function finish() {
      var s = S();
      ld.classList.add('go');
      // 1) открывается квадрат — в нём виден сайт
      ld.style.setProperty('--w', s + 'px'); ld.style.setProperty('--h', s + 'px');
      setTimeout(function () {
        // 2) квадрат раскрывается на весь экран, уголки уходят за края
        var W = innerWidth + 40, H = innerHeight + 40;
        ld.classList.add('full');
        ld.style.setProperty('--w', W + 'px'); ld.style.setProperty('--h', H + 'px');
        ld.style.setProperty('--c', Math.max(W, H) + 'px');
        html.classList.remove('is-loading');           // стартуют анимации первого экрана
        scrollTo(0, 0);
        dispatchEvent(new Event('loaderdone'));
        setTimeout(function () { ld.remove(); }, 1100);
      }, 1050);
    }
    requestAnimationFrame(tick);
  })();
</script>
