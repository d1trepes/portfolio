---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
---
<!-- Временная страница: шаблон кейса сделаем на этапе «Кейсы». -->
<Base title={`${project.data.title} — Иван Засадыч`}>
  <main class="case-stub gutter">
    <p class="case-stub__tag">{project.data.tag}</p>
    <h1>{project.data.title}</h1>
    <p class="case-stub__note">Кейс скоро появится здесь.</p>
    <a class="btn btn--light" href="/#featured">Назад к проектам</a>
  </main>
</Base>

<style>
  .case-stub{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px}
  .case-stub__tag{margin:0;font-size:14px;color:var(--muted)}
  h1{margin:0;font-family:var(--f-caps);font-weight:800;text-transform:uppercase;font-size:clamp(36px,6vw,84px);line-height:1.02;letter-spacing:-.012em;max-width:14ch}
  .case-stub__note{margin:6px 0 18px;color:var(--muted)}
</style>
