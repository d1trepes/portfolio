---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props { title?: string; description?: string }
const {
  title = 'Иван Засадыч — веб-дизайнер',
  description = 'Делаю сайты, вникая с головой: лендинги, многостраничные и B2B-сайты под ключ.',
} = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F3F3F1" />
    <link rel="preload" as="image" href="/hero/portrait.webp" fetchpriority="high" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <div class="toast" id="toast" role="status"></div>
  </body>
</html>
